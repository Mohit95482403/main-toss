# ==============================================================================
# IRONMAN TOSS BOOK - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual settings.
# Never commit the actual .env file with real credentials to version control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ironman_toss_book
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_CONNECTION_LIMIT=10

# Security & CORS
# Allowed frontend origin (e.g., Live Server on 5500 or Vite/other dev server)
FRONTEND_ORIGIN=http://localhost:5500
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Application Metadata
APP_NAME="IRONMAN TOSS BOOK API"
API_PREFIX=/api
