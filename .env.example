# ==============================================================================
# DADDY TOSS BOOK - Production & Development Environment Configuration
# Copy this file to .env and replace placeholders with your actual settings.
# CRITICAL: Never commit the actual .env file or real credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Environment
# ------------------------------------------------------------------------------
# Environment mode: 'production' or 'development'
NODE_ENV=production

# Port number for Express API server (Render automatically provides PORT in production)
PORT=5000

# Host binding (Render requires 0.0.0.0)
HOST=0.0.0.0

# Trust upstream reverse proxy headers (e.g., Render, Cloudflare, ALB)
# Set to 'true' or '1' when deployed behind a TLS terminating proxy
TRUST_PROXY=true

# Standalone container mode: set to 'true' to serve frontend HTML/CSS/JS directly from Express
# Set to 'false' when frontend is deployed separately on Vercel
SERVE_STATIC_FRONTEND=false

# Optional persistent storage path for team logos and media uploads
# (e.g., '/var/data/uploads' if using a Render Persistent Disk)
# UPLOADS_DIR=

# ------------------------------------------------------------------------------
# 2. Database Configuration (Aiven MySQL 8.4 / Managed Cloud MySQL)
# ------------------------------------------------------------------------------
# OPTION A: Full connection URI (Recommended for Render)
# DATABASE_URL=mysql://avnadmin:your_aiven_password@daddytossbook-narendra-connectly.l.aivencloud.com:20135/daddy_toss_book?ssl-mode=REQUIRED

# OPTION B: Discrete connection credentials
DB_HOST=daddytossbook-narendra-connectly.l.aivencloud.com
DB_PORT=20135
DB_NAME=daddy_toss_book
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_CONNECTION_LIMIT=10

# Database SSL/TLS:
# Required for Aiven Cloud MySQL (enforces strict TLS certificate verification)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional: Paste Aiven Project CA certificate string, or specify path (e.g., /etc/secrets/ca.pem on Render)
# DB_SSL_CA=

# ------------------------------------------------------------------------------
# 3. Security, CORS & Domain Configuration
# ------------------------------------------------------------------------------
# Production Frontend URL (Your deployed Vercel domain, e.g., https://daddy-toss-book.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app

# Alternative origin variable (alias for FRONTEND_URL)
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Additional comma-separated allowed origins (e.g., custom domains, staging)
# ALLOWED_ORIGINS=https://your-domain.com,https://preview.your-domain.com

# Allow Vercel preview branch deployments (*.vercel.app)
# ALLOW_VERCEL_PREVIEWS=false

# High-entropy cryptographic secret for HMAC-SHA256 session token signatures
# In production, must be at least 32 characters long.
# Generate on CLI: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# ------------------------------------------------------------------------------
# 4. Root Administrator Provisioning (Optional on first initialization)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@daddytossbook.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=ReplaceWithStrongPassword2026!
ADMIN_FULL_NAME=System Administrator

# ------------------------------------------------------------------------------
# 5. Application Metadata
# ------------------------------------------------------------------------------
APP_NAME="DADDY TOSS BOOK API"
API_PREFIX=/api
