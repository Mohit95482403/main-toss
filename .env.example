# ==============================================================================
# IRONMAN TOSS BOOK - Production & Development Environment Configuration
# Copy this file to .env and replace placeholders with your actual settings.
# CRITICAL: Never commit the actual .env file or real credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Environment
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development
# Port number for Express API server (1-65535)
PORT=5000
# Trust upstream reverse proxy headers (e.g. AWS ALB, Nginx, Cloudflare, Render, Railway)
# Set to 'true' or '1' when deployed behind a TLS terminating proxy
TRUST_PROXY=false
# Standalone container mode: set to 'true' to serve frontend HTML/CSS/JS directly from Express
SERVE_STATIC_FRONTEND=false

# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL v8.0+)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ironman_toss_book
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_CONNECTION_LIMIT=10

# Database SSL/TLS (Required for AWS RDS, Google Cloud SQL, PlanetScale, DigitalOcean)
# Set DB_SSL=true to enable TLS encryption
DB_SSL=false
# Set DB_SSL_REJECT_UNAUTHORIZED=false only if using self-signed internal certificates
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional: Path to custom CA certificate file or raw PEM certificate content
# DB_SSL_CA=/path/to/ca-certificate.crt

# ------------------------------------------------------------------------------
# 3. Security, CORS & Authentication
# ------------------------------------------------------------------------------
# Allowed frontend origin in production (e.g., https://tossbook.example.com)
# In development, localhost:5500 and 127.0.0.1:5500 are automatically permitted
FRONTEND_ORIGIN=http://localhost:5500

# High-entropy cryptographic secret for HMAC-SHA256 session token signatures
# In production, must be at least 32 characters long.
# Generate on CLI with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# ------------------------------------------------------------------------------
# 4. Root Administrator Provisioning (Optional on first initialization)
# ------------------------------------------------------------------------------
# In production, specify a secure unique password if running root provisioning.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ironmantossbook.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=Admin@Ironman2026
ADMIN_FULL_NAME=System Administrator

# ------------------------------------------------------------------------------
# 5. Application Metadata
# ------------------------------------------------------------------------------
APP_NAME="IRONMAN TOSS BOOK API"
API_PREFIX=/api
