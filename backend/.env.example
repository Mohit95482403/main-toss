# ==============================================================================
# DADDY TOSS BOOK - Backend Environment Configuration (Render / Production)
# Copy this file to .env and replace placeholders with your actual settings.
# CRITICAL: Never commit the actual .env file or real credentials to Git!
# ==============================================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0
TRUST_PROXY=true
SERVE_STATIC_FRONTEND=false

# Optional persistent storage path for team logos (Render Persistent Disk)
# UPLOADS_DIR=/var/data/uploads

# ------------------------------------------------------------------------------
# Database Configuration (MySQL v8.0+)
# ------------------------------------------------------------------------------
# OPTION A: Full connection URI (Standard on Cloud MySQL)
# DATABASE_URL=mysql://username:password@hostname:3306/database_name?ssl-mode=REQUIRED

# OPTION B: Discrete connection credentials
DB_HOST=your-mysql-hostname.example.com
DB_PORT=3306
DB_NAME=daddy_toss_book
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_CONNECTION_LIMIT=10

# Database SSL/TLS:
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=

# ------------------------------------------------------------------------------
# Security, CORS & Authentication
# ------------------------------------------------------------------------------
FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_ORIGIN=https://your-frontend.vercel.app
# ALLOWED_ORIGINS=https://your-domain.com
# ALLOW_VERCEL_PREVIEWS=false

SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# ------------------------------------------------------------------------------
# Initial Root Administrator Provisioning (Optional)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@daddytossbook.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=ReplaceWithStrongPassword2026!
ADMIN_FULL_NAME=System Administrator

APP_NAME="DADDY TOSS BOOK API"
API_PREFIX=/api
